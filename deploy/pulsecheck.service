[Unit]
Description=PulseCheck customer signal page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsecheck
Group=pulsecheck
ExecStart=/usr/local/bin/pulsecheck -config /etc/pulsecheck/pulsecheck.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pulsecheck

[Install]
WantedBy=multi-user.target
