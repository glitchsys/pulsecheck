# PulseCheck listens on PORT (default 8080).
PORT=8080

# sqlite (a local file) or mysql (a server you run).
DB_DRIVER=sqlite

# Used when DB_DRIVER=sqlite. One process only. Mount a volume here in Docker.
SQLITE_PATH=./data/pulsecheck.db

# Used when DB_DRIVER=mysql. The app does not start MySQL for you.
# Local compose profile: pulsecheck:pulsecheck@tcp(mysql:3306)/pulsecheck?parseTime=true&charset=utf8mb4
# DATABASE_URL=

# Replace these three before the port is reachable beyond your machine.
ADMIN_PASSWORD=replace-this-admin-password
SESSION_SECRET=replace-this-session-secret
IP_HASH_PEPPER=replace-this-ip-hash-pepper

PRODUCT_NAME=PulseCheck
# Optional link shown in the header.
# OFFICIAL_STATUS_URL=https://status.example.com

# slug:Display name, comma-separated. Seeded only when the database has no services yet.
SERVICES=web:Web application,api:API,auth:Authentication

# Last-hour totals at or above these values change the badge.
# The same numbers color each chart bucket.
SPIKE_THRESHOLD_AMBER=3
SPIKE_THRESHOLD_RED=10

# One counted report per IP hash per service inside this window.
DEDUPE_WINDOW_MINUTES=10

# Chart bucket size. One of 5, 10, 15, 20, 30, 60.
BUCKET_MINUTES=15

# Set true only when a reverse proxy is the sole path to PulseCheck.
# Otherwise a client can spoof X-Forwarded-For and skip the dedupe window.
TRUST_PROXY=false

# Set true when visitors reach PulseCheck over HTTPS.
COOKIE_SECURE=false

# Leave SMTP_HOST empty to store reports without sending mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=pulsecheck@example.com
# SUPPORT_EMAIL=support@example.com
